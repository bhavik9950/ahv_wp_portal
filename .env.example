APP_NAME="AH&V WhatsApp Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

# Reverse proxy / tunnel. "*" when exposing local dev via Cloudflare Tunnel or
# ngrok; a comma-separated list of proxy IPs/CIDRs in production; empty = none.
# ("*" is ignored in production — see bootstrap/app.php.)
TRUSTED_PROXIES=

# CORS: comma-separated exact origins for any browser-facing /api route. Empty =
# no cross-origin access (correct while only the webhook lives under /api).
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (no MySQL service required). Production: set DB_CONNECTION=mysql.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahv_waba
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Media storage. 'local' for testing (stored under storage/app/private/media,
# served via signed URLs). Switch to 'r2' in production and fill the R2_* vars.
WABA_MEDIA_DISK=local
WABA_MEDIA_URL_TTL=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp / WABA
# 'mock' = offline simulator (recommended for local dev/tests, no real messages sent).
# 'meta_cloud_api' = real Meta Graph API calls. Phases 1-2 do not need real sends.
WABA_DRIVER=meta_cloud_api
WHATSAPP_SENDING_ENABLED=true
WABA_BASE_URL=https://graph.facebook.com
WABA_API_VERSION=v22.0
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_DEFAULT_COUNTRY_CODE=91
WABA_USE_TEMPLATES=true
WABA_TEMPLATE_LANGUAGE=en
WABA_TEMPLATE_ORDER_DISPATCHED=order_dispatched_update
WABA_TEMPLATE_ORDER_READY=order_ready_for_delivery
WABA_TEMPLATE_ORDER_READY_PAYMENT_DUE=order_ready_payment_due
WABA_TEMPLATE_ORDER_DELAYED=order_delayed_update
WABA_TEMPLATE_ORDER_DELIVERED=order_delivered_confirmation
# WhatsApp Business Account (WABA) ID — the asset_id in WhatsApp Manager,
# NOT the phone number id.
WABA_BUSINESS_ACCOUNT_ID=
# Meta Business / portfolio ID (optional) — the business_id in the WhatsApp Manager URL.
WABA_META_BUSINESS_ID=
WABA_APP_ID=
# Any random string you also set as the Callback verify token in Meta.
WABA_WEBHOOK_VERIFY_TOKEN=
WABA_APP_SECRET=
WABA_LOG_CHANNEL=whatsapp
# Set to false only for local testing without the Meta app secret.
WABA_WEBHOOK_REQUIRE_SIGNATURE=true

# Voice broadcast (SMS Gateway Center Voice API) — recorded outbound call campaigns.
# 'mock' = offline simulator; 'smsgatewaycenter' = real calls.
VOICE_DRIVER=mock
VOICE_BASE_URL=https://unify.smsgateway.center/VoiceApi
VOICE_USER_ID=
VOICE_PASSWORD=
VOICE_API_KEY=
VOICE_MAX_RECIPIENTS=2000