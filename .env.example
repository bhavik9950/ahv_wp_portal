APP_NAME="AH&V WhatsApp Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Dedicated WhatsApp log channel (see config/logging.php). Never logs tokens/secrets.
WABA_LOG_CHANNEL=whatsapp

# --- Database -------------------------------------------------------------
# Local dev: sqlite (no service needed). Production: mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ahv_waba
# DB_USERNAME=ahv_waba
# DB_PASSWORD=

# --- Sessions ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Queue / Cache / Broadcast ----------------------------------------
# Local dev: database. Production: redis (+ Laravel Horizon).
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@ahv.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (media) ------------------------------------------
# Local dev: 'local'. Production: 'r2'.
WABA_MEDIA_DISK=local
WABA_MEDIA_URL_TTL=300

# Cloudflare R2 (S3-compatible). Bucket should be PRIVATE — the app serves
# short-lived signed URLs. Endpoint looks like:
#   https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
# Only if the bucket is deliberately exposed on a public domain:
R2_PUBLIC_URL=

# --- WhatsApp / WABA -------------------------------------------------
# Driver: 'mock' (offline simulator, recommended for dev/tests) or 'meta_cloud_api'.
WABA_DRIVER=mock
# Global emergency kill switch. If false, NO outbound job will call Meta.
WHATSAPP_SENDING_ENABLED=true
WABA_BASE_URL=https://graph.facebook.com
WABA_API_VERSION=v22.0
WABA_DEFAULT_COUNTRY_CODE=91
WABA_TEMPLATE_LANGUAGE=en

# Bootstrap / single-tenant fallback credentials ONLY.
# Real deployments store per-organization credentials ENCRYPTED in the database
# via the WABA configuration UI — do NOT put production tokens here.
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_ACCOUNT_ID=
WABA_APP_ID=
WABA_APP_SECRET=
WABA_WEBHOOK_VERIFY_TOKEN=

# --- Tenancy --------------------------------------------------------
# 'single' = one company, resolved automatically (current default).
# 'multi'  = re-enable the organization picker / membership checks.
TENANT_MODE=single
TENANT_ORGANIZATION_ID=

VITE_APP_NAME="${APP_NAME}"
